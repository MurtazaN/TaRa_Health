    <diagram id="flow-proactive" name="4 · Proactive (E4 M4–M5)">
        <mxGraphModel dx="900" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="820" math="0" shadow="0">
            <root>
