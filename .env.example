# ---- Storage (local-first) ----
# TARA_DATA_DIR: documents, db, and vector index live here. Leaving it unset (the
# default) resolves to <repo>/.tara_data, repo-anchored because every entry point
# (Makefile, bootstrap.sh) changes the working directory to backend/ before running.
# A relative value set here is resolved against the working directory at run time.
# TARA_DATA_DIR=./.tara_data
TARA_DB_KEY=                        # passphrase for SQLCipher (leave blank to run unencrypted in dev)

# ---- Server / frontend ----
# TARA_FRONTEND_DIR=                 # templates + static assets. Unset resolves to <repo>/frontend;
                                      # the container pins it to /app/frontend instead.
# TARA_SERVER_HOST=127.0.0.1         # loopback default - this app has no authentication and serves
                                      # PHI. Setting 0.0.0.0 exposes it to the local network and is
                                      # intended ONLY inside the container, where Compose's published
                                      # port is pinned to loopback (127.0.0.1:8000:8000) - Docker
                                      # mediates exposure there, so the container-internal bind can
                                      # safely be wide. Do not set this to 0.0.0.0 on a bare host.

# ---- Model mode ----
# local  = always use the on-device model (private, offline)
# hosted = always use the hosted frontier model (opt-in; data leaves device)
# hybrid = local by default, escalate to hosted only when the user opts in per-query
TARA_MODEL_MODE=local

# ---- Local model ----
# Two on-device backends are supported, chosen by TARA_LOCAL_LLM_BACKEND:
#   openai_compatible = an OpenAI-style server (e.g. LM Studio) at TARA_LMSTUDIO_HOST
#   ollama            = Ollama at TARA_OLLAMA_HOST
TARA_LOCAL_LLM_BACKEND=openai_compatible
TARA_LMSTUDIO_HOST=http://localhost:1234    # OpenAI-compatible base; "/v1" is appended
TARA_OLLAMA_HOST=http://localhost:11434     # used only when TARA_LOCAL_BACKEND=ollama
TARA_LOCAL_MODEL=gemma3/medgemma-4b-it      # LM Studio model id, or e.g. qwen3:8b for Ollama
TARA_LOCAL_API_KEY=not-needed               # LM Studio ignores this; the openai client needs a non-empty value

# ---- Hosted model (only used in hosted/hybrid mode; data leaves the device) ----
# The startup validator FAILS if model_mode is hosted/hybrid and TARA_HOSTED_API_KEY is empty.
TARA_HOSTED_MODEL=google/medgemma-27b-text-it
TARA_HOSTED_API_KEY=                        # provider-specific wiring is settled in Slice 2

# ---- Embeddings (local, on-device via LM Studio /v1/embeddings) ----
# Embeddings never egress, even in hosted mode. The model<->dim pairing is verified
# at index time against the stored index_meta row (a mismatch forces a re-index).
TARA_EMBED_MODEL=text-embedding-qwen3-embedding-0.6b
TARA_EMBED_DIM=1024

# ---- Retrieval ----
TARA_TOP_K=6

# ---- Limits / timeouts ----
TARA_MAX_UPLOAD_BYTES=52428800              # 50 MB upload ceiling
TARA_LLM_TIMEOUT_SECONDS=60                 # a stalled model can't hang a request forever
