# ---- Storage (local-first) ----
# TARA_DATA_DIR: documents, db, and vector index live here. Leaving it unset (the
# default) resolves to <repo>/.tara_data, repo-anchored because every entry point
# (Makefile, bootstrap.sh) changes the working directory to backend/ before running.
# A relative value set here is resolved against the working directory at run time.
# TARA_DATA_DIR=./.tara_data
TARA_DB_KEY=                        # passphrase for SQLCipher (leave blank to run unencrypted in dev)

# ---- Server / frontend ----
# TARA_FRONTEND_DIR=                 # templates + static assets. Unset resolves to <repo>/frontend;
                                      # the container pins it to /app/frontend instead.
# TARA_SERVER_HOST=127.0.0.1         # loopback default - this app has no authentication and serves
                                      # PHI. Setting 0.0.0.0 exposes it to the local network and is
                                      # intended ONLY inside the container, where Compose's published
                                      # port is pinned to loopback (127.0.0.1:8000:8000) - Docker
                                      # mediates exposure there, so the container-internal bind can
                                      # safely be wide. Do not set this to 0.0.0.0 on a bare host.

# ---- Generation mode (governs GENERATION ONLY) ----
# local          = always use the on-device model (private, fully offline)
# agent_platform = always use Google Cloud Agent Platform (opt-in; excerpts leave the device)
# hybrid         = local by default, escalate only when the user opts in per-query
# Embeddings are in-process in EVERY mode and never egress.
TARA_GENERATION_MODE=local

# ---- Local model ----
# Two on-device backends are supported, chosen by TARA_LOCAL_LLM_BACKEND:
#   openai_compatible = an OpenAI-style server (e.g. LM Studio) at TARA_LMSTUDIO_HOST
#   ollama            = Ollama at TARA_OLLAMA_HOST
TARA_LOCAL_LLM_BACKEND=openai_compatible
TARA_LMSTUDIO_HOST=http://localhost:1234    # OpenAI-compatible base; "/v1" is appended
TARA_OLLAMA_HOST=http://localhost:11434     # used only when TARA_LOCAL_BACKEND=ollama
TARA_LOCAL_MODEL=gemma3/medgemma-4b-it      # LM Studio model id, or e.g. qwen3:8b for Ollama
TARA_LOCAL_API_KEY=not-needed               # LM Studio ignores this; the openai client needs a non-empty value

# ---- Google Cloud Agent Platform (generation only) ----
# The startup validator FAILS if generation_mode is agent_platform/hybrid and
# TARA_GCP_PROJECT is empty — an empty project silently routes to the consumer
# Gemini Developer API, which is NOT covered by a GCP BAA.
TARA_GCP_PROJECT=
TARA_GCP_LOCATION=us-central1
TARA_AGENT_PLATFORM_PROVIDER=gemini         # gemini | llama | mistral
TARA_GEMINI_MODEL=gemini-3.5-flash
TARA_LLAMA_MODEL=meta/llama-3.3-70b-instruct-maas
TARA_MISTRAL_MODEL=mistral-medium-3
# Set true ONLY once a signed GCP BAA covers Agent Platform. Nothing checks this
# for you; it records that a human asserted it.
TARA_PHI_EGRESS_ACKNOWLEDGED=false

# ---- Embeddings (in-process; never egress, in any mode) ----
# Pinned by revision so the vector space cannot change between installs.
TARA_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
TARA_EMBED_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
TARA_EMBED_DIM=1024

# ---- Chunking (validated at startup against the embedding model's limit) ----
TARA_CHUNK_TARGET_TOKENS=800
TARA_CHUNK_OVERLAP_TOKENS=100

# ---- Retrieval ----
TARA_TOP_K=6

# ---- Limits / timeouts ----
TARA_MAX_UPLOAD_BYTES=52428800              # 50 MB upload ceiling
TARA_LLM_TIMEOUT_SECONDS=60                 # a stalled model can't hang a request forever

# ---- PHI redaction ----
# On by default. Redaction is what makes tracing and hosted egress safe on a
# health corpus; disable it only for local debugging on synthetic data.
TARA_PHI_REDACTION_ENABLED=true
# The spaCy model is pinned as a wheel dependency in pyproject.toml, not an
# env knob: bootstrap copies this file only when .env is absent, so anyone
# who bootstrapped earlier would keep a stale value here and an env var
# beats the config.py default - re-introducing exactly the recall gap that
# was measured and fixed. config.py is the single source of truth.
